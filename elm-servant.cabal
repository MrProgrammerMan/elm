cabal-version: 2.4
name:          elm-servant
version:       0.1.0.0
build-type:    Simple
 
executable elm-servant
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >=4 && <5, servant-server >=0.20, warp
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts "-with-rtsopts=-N"